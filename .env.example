# Settings for `docker compose up`. Copy to .env and change every value (.env is ignored by git).
# Passwords: letters, digits, '-' and '_' only (they are passed to MySQL's setup script).
MYSQL_ROOT_PASSWORD=change-me-root
CF_META_PASSWORD=change-me-meta
CF_ENGINE_PASSWORD=change-me-engine
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-32-chars-or-more
# Where the app opens: http://localhost:3100
WEB_PORT=3100
